{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daolue",
  "version": "0.1.0",
  "identifier": "com.daxi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend/packaging/dist/daxi": "backend"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5NzUzM0ZBMjU4NTMxNkQKUldSdE1ZVWwrak4xR1FQbnYzOEJxK0tOQTlPMWdxaUdXY0hENDdFczdXS2dFeExBN1ZVaTgzUzAK",
      "endpoints": [
        "https://github.com/jingchen0529/ticket-lens/releases/latest/download/latest.json"
      ]
    }
  }
}